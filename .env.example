# OpportunityLens AI Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Google Gemini API Key (Required for intelligent fact extraction & reasoning)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Configuration
GEMINI_MODEL=gemini-3.8-flash

# Real Web Search API Integrations (Optional - falls back gracefully to live DuckDuckGo / Tech Index)
# Tavily API: https://tavily.com/
TAVILY_API_KEY=
# Serper (Google Search) API: https://serper.dev/
SERPER_API_KEY=
# Brave Search API: https://brave.com/search/api/
BRAVE_API_KEY=
# Search Provider selection: auto | tavily | serper | brave | duckduckgo | live-index
SEARCH_PROVIDER=auto

# Research Agent Tunables
MAX_SEARCH_RESULTS=8
FETCH_TIMEOUT_MS=8000
MAX_RESPONSE_SIZE_BYTES=2097152
MAX_CONCURRENT_FETCHES=5
FOLLOW_VACANCY_LINKS=true
MAX_VACANCY_LINKS_PER_PAGE=2
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Client Configuration (for Vite)
# In dev mode, Vite proxies /api to http://localhost:5000
